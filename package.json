{
  "name": "minami-dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Minami Bento — a local, real-time mission-control for your Claude Code sessions. Every session on your machine becomes a live bento tile, with an optional cross-machine usage dashboard.",
  "keywords": [
    "claude-code",
    "claude",
    "dashboard",
    "bento",
    "developer-tools",
    "nextjs",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pdtoan2811-bit/minami-dashboard.git"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "next build",
    "build:check": "NEXT_DIST_DIR=.next-verify next build",
    "start": "next start",
    "lint": "next lint",
    "serve": "bash bin/serve.sh",
    "deploy": "bash bin/deploy.sh",
    "dev:iterate": "NODE_ENV=development NEXT_DIST_DIR=.next-dev PORT=3001 next dev",
    "kb": "node public/kb/serve.mjs",
    "check": "tsx scripts/regression.mts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@playwright/mcp": "^0.0.78",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.469.0",
    "motion": "^12.42.2",
    "next": "^15.5.22",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "simple-icons": "^16.27.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "@hono/node-server": "^2.0.5"
  },
  "engines": {
    "node": ">=18.18"
  }
}
