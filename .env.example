# Minami Bento — environment.
#
# Copy to .env.local and fill in what you want. EVERYTHING here is OPTIONAL: the Bento home page (/)
# needs none of it — it reads ~/.claude/projects directly, so a fresh clone fills with your own
# Claude Code sessions on `npm run dev` with this file untouched.
#
# Never commit the filled-in .env.local (it's git-ignored).
#
# Every value below is shown as `NAME=` with its built-in default named in the comment above it.
# Blank means "use the default" — it does not mean "empty string". Defaults that mention a path are
# resolved against your own $HOME, so nothing here is specific to the machine that wrote it.

# ══ What you are most likely to want ═════════════════════════════════════════════════════════════

# ── Metrics API (powers the /dashboard cards) ────────────────────────────────
# Base URL of the self-hosted metrics collector (see server/README.md). Leave blank to run without
# cross-machine metrics — the metrics cards just show "no source".
# NEXT_PUBLIC_* is exposed to the browser; the read key is obscurity only, so gate the deploy
# (password / auth) if you need real privacy.
NEXT_PUBLIC_METRICS_URL=
NEXT_PUBLIC_METRICS_KEY=

# ── Pluggable side panels (/dashboard: Task log / People / Trace-back / Analytics)
# Absolute path to a JSON file that backs those cards. See panels.example.json for the shape.
# Leave blank and the cards are simply empty (no personal data ships in this repo).
# Default: unset — cards render empty.
MINAMI_PANELS_FILE=

# ── Browser tool (live-drive sessions) ────────────────────────────────────────
# Every live-driven chat is given a browser tool (Playwright MCP, headless, isolated per session) so
# Claude can navigate/click/screenshot your own apps for visual QA — see README.md. It's deferred
# behind tool search, so a chat that never uses it costs ~nothing. Set to 1 to turn it off entirely.
# Default: enabled.
MINAMI_DISABLE_BROWSER_TOOL=

# ── Preferred Claude account ──────────────────────────────────────────────────
# The account the Accounts panel expects every session to be billing. If the live credential in
# ~/.claude.json doesn't match this, the panel raises a wrong-account alert.
#
# Default: EMPTY, which switches the check OFF — with no preferred account there is no such thing as
# being off it. Set it here, or pick one in Settings (which writes ~/.minami/account.json and wins
# over this var). Only useful if you run several Claude accounts; if you have one, ignore this.
# Requires the `token-slayer` CLI to enumerate a pool.
MINAMI_PREFERRED_ACCOUNT=

# ══ Models ═══════════════════════════════════════════════════════════════════════════════════════
# All model ids live in lib/model-pins.ts. Never hardcode one elsewhere — the dashboard alerts when a
# spawner drifts off the pin, and a second copy of the id makes the alert lie.

# The model every judgement-layer spawner on this box should run. Default: claude-opus-5
MINAMI_PINNED_MODEL=

# The dashboard's own chat sessions. Default: whatever MINAMI_PINNED_MODEL resolves to.
MINAMI_DASHBOARD_MODEL=

# The cheap worker behind tile labels, goal/task inference, and the flow view's narration.
# Deliberately NOT the pin — this is mechanical summarisation on a hot path. Default: claude-haiku-4-5
MINAMI_CHEAP_MODEL=

# The flow view's model-written summaries ("what was wanted, and how it turned out"). Set to 0 to run
# the flow view on its rules-derived summaries alone — everything still works, the sentences are just
# mechanical. One MINAMI_CHEAP_MODEL call per batch of finished milestones, cached to disk and never
# re-run for unchanged work. Default: on.
MINAMI_FLOW_NARRATE=

# How many milestones the narrator summarises per call. Default: 8
MINAMI_FLOW_NARRATE_BATCH=

# Reasoning effort for dashboard sessions. Default: unset (the CLI's own default).
MINAMI_DASHBOARD_EFFORT=

# Auto-compact threshold, as a percentage of the context window. Default: the CLI's own default.
MINAMI_DASHBOARD_AUTOCOMPACT_PCT=

# Permission mode for every dashboard-hosted session. Default: bypassPermissions — every tool call is
# auto-approved with no prompt, enforced by the server's own canUseTool. Read the "Security posture"
# note in CLAUDE.md before changing this; the dashboard is built for loopback/local use.
MINAMI_DASHBOARD_PERMISSION_MODE=

# Where the Minami Slack bot repo lives, read only to report which model IT is pinned to. Absent on
# most machines, in which case the pin check reports "not found on this host" and moves on.
# Default: ~/Minami
MINAMI_BOT_DIR=

# ══ Paths and state ══════════════════════════════════════════════════════════════════════════════
# The dashboard keeps its own state under ~/.minami. Override individually only if you need to.

# Which URL the CLI tools (bin/agent.mjs, bin/team.mjs, bin/task.mjs) and the agent runner call back on.
# Default: http://127.0.0.1:3000
MINAMI_DASHBOARD_URL=

# Where this checkout lives, for the bin/team.mjs path written into a workspace's CLAUDE.md team
# block. Default: the server's working directory, which is this repo.
MINAMI_DASHBOARD_DIR=

# Agent registry: one JSON file per agent. Default: ~/.minami/agents
MINAMI_AGENTS_DIR=

# Assigned-task queue for agents. Default: ~/.minami/agent-tasks.json
MINAMI_AGENT_TASKS=

# Product registry for the Teams view: one JSON file per product. Default: ~/.minami/products
MINAMI_PRODUCTS_DIR=

# Team runs: one folder per run, holding run.json and the dossier. Default: ~/.minami/runs
MINAMI_RUNS_DIR=

# Where a template's role agents get their home folders (one per role, shared across every product
# that uses that role). Default: ~/brains
MINAMI_BRAINS_DIR=

# Where a new product's record folder is created by default. Default: ~/secondBrain/10-19 Projects
MINAMI_RECORDS_DIR=

# Which account the wrong-account alert measures against. Default: ~/.minami/account.json
MINAMI_ACCOUNT_CONFIG=

# Autopilot's settings (merge / deploy / resolve toggles). Default: ~/.minami/autopilot.json
MINAMI_AUTOPILOT_CONFIG=

# Set to 1 to stop autopilot from running at all. Default: enabled (but it does nothing until you
# turn on merge/deploy in its config).
MINAMI_AUTOPILOT_DISABLE=

# Set to 0 to stop the dashboard giving a second blank chat in a folder its own git worktree.
# Default: on. Two chats in one checkout share a branch and an index, so whoever writes last wins,
# silently — isolation makes that impossible instead of merely unlikely. Off means you get the old
# "N agents are live in this folder" warning and nothing else. Only applies to NEW blank chats in a
# git repo: reopening an existing conversation always resumes in the folder it was born in.
MINAMI_AUTO_ISOLATE=

# Out-of-pane alert log, written by bin/minami-event.mjs so alerts survive the deploy that made them.
# Default: ~/.minami/events.jsonl
MINAMI_EVENTS=

# Where pasted images from the composer are written. Default: ~/.minami/pastes
MINAMI_PASTES=

# ══ Timeouts (milliseconds) ══════════════════════════════════════════════════════════════════════
# Raise these on a slow box; the defaults are tuned for a laptop that sleeps.

# How long a session may sit with NO connected client before its CLI subprocess is reaped. The floor
# is 60s. Backgrounding a mobile tab tears down the SSE stream, so "no listeners" is routine and
# temporary — that's why this is 30 minutes and not 10. Default: 1800000 (30 min)
MINAMI_IDLE_REAP_MS=

# How long a turn may stay parked on a permission / question prompt before it gives up.
# Default: see lib/agent/manager.ts
MINAMI_HOLD_TIMEOUT_MS=

# Ceiling on a single assigned agent task. Default: see lib/agents/runner.ts
MINAMI_AGENT_TASK_TIMEOUT_MS=

# How long an agent task may sit awaiting a human before the runner stops waiting.
# Default: see lib/agents/runner.ts
MINAMI_AGENT_AWAIT_LIMIT_MS=

# Ceiling on a whole team run, across all its stages. Each stage still has the per-task limit above;
# this is the backstop for a chain of individually-legal stages. Default: see lib/teams/run.ts
MINAMI_TEAM_RUN_TIMEOUT_MS=

# ══ Metrics collector (server/metrics-server.js) ═════════════════════════════════════════════════
# Only relevant if you run the collector — it's a separate process from the Next app.
# See server/README.md. It binds loopback by default; keep it that way unless you front it with TLS
# and auth, since it accepts writes.

# Port the collector listens on. Default: 8787
PORT=

# Interface it binds. Default: 127.0.0.1 (loopback only — do NOT expose this without auth)
BIND=

# Where it stores events.jsonl. Default: ~/.minami-metrics
METRICS_DIR=

# Shared secret required to WRITE metrics. Default: empty (no auth — fine on loopback only).
INGEST_TOKEN=

# Shared secret required to READ metrics. Must match NEXT_PUBLIC_METRICS_KEY above.
# Default: empty (no auth).
READ_KEY=

# ══ Meeting canvas — live transcript → canvas (OpenRouter) ═══════════════════════════════════════
# Powers /canvas when it is driven by a real model instead of a scripted demo. The model reads
# transcript lines and emits canvas ACTIONS (add / focus / state / merge / edge / amend), which are
# the same actions the scripted demos already use — so the renderer, the operator panel and the
# reducer are all unchanged. One contract, two producers.
#
# Note the deliberate exception to the "all model ids live in lib/model-pins.ts" rule above: those
# pins govern Claude spawners on this box. This is a different provider on a different code path,
# and pinning it in the same registry would imply the drift alert covers it. It does not.

# Your OpenRouter key. SERVER-SIDE ONLY — never prefix this with NEXT_PUBLIC_, or it ships to the
# browser and anyone watching your screen share can read it out of the bundle.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# API base. Default: https://openrouter.ai/api/v1 — override only for a proxy or a mock.
OPENROUTER_BASE_URL=

# Optional attribution headers OpenRouter uses for its public rankings (HTTP-Referer / X-Title).
# Harmless to leave empty; set them if you want the usage attributed.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# ── the canvas pipeline (see §17) ────────────────────────────────────────────────────────────────
# This was a three-arm A/B ladder. The ladder settled it — a chat LLM doing ASR lost on latency,
# accuracy and cost at once — and xiaomi/mimo-v2.5 is now removed entirely, along with OPENROUTER_MODEL
# and the mode= arms. One config remains: a real ASR model hears, one fast model does all the thinking.
#
# ⚠️ Every cost figure in §17 was measured with mimo judging. Exactly ONE survives its removal: the
# ASR leg at $0.110/audio-hour. Treat everything else as unmeasured until a run prints its own report.

# The audio the canvas transcribes. No default worth trusting — the code falls back to a file in
# ~/Downloads that only exists on anh's Mac.
CANVAS_AUDIO_FILE=

# Second recording for the live canvas. Two sources rather than one because comparing arms on a
# single recording tells you how that recording behaves, not how the pipeline does — a monologue
# produces no disagreement to react to, a two-hander produces speaker confusion. Both are picked
# from the operator panel; neither is copied into the repo.
CANVAS_AUDIO_FILE_2=

# The speech-to-text model, via OpenRouter's /audio/transcriptions endpoint.
# Default: google/chirp-3 — chosen 2026-08-14 on two real clips of VI/EN code-switching, which is the
# actual workload and which no earlier comparison had tested. It was the ONLY model that transcribed
# "tiếng Việt có tiếng Anh xen lẫn ở đấy" correctly, and the only one that never invented content.
#
# What the others did on the same audio:
#   whisper-large-v3     hallucinated a YouTube outro ("Hãy subscribe cho kênh La La School")
#   gpt-4o-transcribe    silently dropped ~80% of the clip
#   deepgram/nova-3      returned empty
#   voxtral-mini         returned Russian, then Korean
#   grok-stt / qwen3-asr usable, wrong on the key word
#
# ⚠️ Fabrication is disqualifying in a way that inaccuracy is not: a wrong word is a bad transcript,
# but an invented sentence reaches the judge and becomes a CARD, so the board asserts things nobody
# said. Weigh any future swap on that first, not on price.
#
# ~$0.96/audio-hour against whisper's $0.09 — but silence-trimming sends only ~40% of meeting time, so
# it lands near $0.40/meeting-hour, still under Recall's $0.50. Slower too (~5.4s vs ~2.3s on a 12s
# clip), which the 10s chunk cadence absorbs.
CANVAS_STT_MODEL=

# ISO-639-1 code for the meeting's language. Default: empty = let the model detect and switch.
# Pin it for a known single-language meeting — auto-detect is decided per chunk and can flap mid-call.
CANVAS_STT_LANGUAGE=

# The model behind all three thinking passes — judge (per chunk), tidy (mid-meeting), relate (once).
# Default: ~deepseek/deepseek-v4-flash-latest — $0.072/M in, $0.144/M out, 1,048,576 context, priced
# 2026-08-12. Against google/gemini-3-flash-preview ($0.50 / $3.00, plus $3.00/M for internal_reasoning
# you are billed for and never see) that is ~21x cheaper on output, dropping the predicted judging leg
# from ~$1.17/audio-hour to ~$0.07.
#
# ⚠️ Chosen on price, which is the one axis that never mattered here — mimo was cheap too and lost on
# latency variance. Nothing has measured this model's latency, its JSON compliance, or its Vietnamese.
# ⚠️ `~...-latest` floats: the model behind it can change without the id changing. Pin
# deepseek/deepseek-v4-flash-0731 when a run has to be reproducible.
CANVAS_DERIVE_MODEL=

# Model for the once-per-run whole-board relationship + reaction pass. Defaults to the model above.
# It is the only step that sees every card at once, so it is where more reasoning genuinely buys
# better edges. Point it at a stronger model only if you would rather have better edges arrive after
# the meeting than good ones arrive during it.
CANVAS_RELATE_MODEL=

# ── the knob still worth sweeping ────────────────────────────────────────────────────────────────
# Chunk length is the liveness floor — you cannot transcribe speech that hasn't been said yet — AND a
# cost multiplier on every leg that runs per chunk. 15s (default) makes 240 judge calls an hour; 60s
# makes 60. Predicted judging spread: ~$1.17/hr against ~$0.33/hr, for 45s more latency to first card.
# Never swept. These exist so sweeping it needs a restart, not a patch.
CANVAS_CHUNK_SECONDS=
CANVAS_OVERLAP_SECONDS=
# Bounded parallelism. The bound is not decoration: removing it once pushed time-to-first-transcript
# from 8s to 29s and failed two chunks in three.
CANVAS_CONCURRENCY=

# ffmpeg/ffprobe, used to slice the audio into chunks.
# Defaults: /opt/homebrew/bin/ffmpeg and /opt/homebrew/bin/ffprobe (Apple-silicon Homebrew).
FFMPEG_PATH=
FFPROBE_PATH=

# Shared secret required to POST /api/canvas. Default: empty (NO AUTH).
#
# Empty is fine on loopback and is why this has never been pushed: the dashboard deploys publicly to
# Vercel, and an unauthenticated write endpoint there means anyone could inject content onto a canvas
# you are screen-sharing to a customer. Set this before any deploy.
CANVAS_INGEST_TOKEN=

# ── Meeting canvas · Recall.ai ────────────────────────────────────────────────
# The bot that joins a Google Meet, streams the audio, and screen-shares the canvas back.
# Key: https://api.recall.ai → Settings → API Keys.  Sent as `Authorization: Token <key>`.
# Server-side only — never NEXT_PUBLIC_.
RECALL_API_KEY=

# Recall is region-scoped and the region is part of the HOST, not a header: a key issued in one
# region returns 401 against another. Match this to wherever the key was created.
#   us-west-2 · us-east-1 · eu-central-1 · ap-northeast-1
RECALL_REGION=us-west-2

# Public HTTPS URL Recall loads as the bot's screen share (output_media). Must be reachable from
# the internet — localhost will render a blank tile. In dev, a tunnel (ngrok/cloudflared) pointing
# at /canvas is the usual answer.
#
# ⚠️ The bot renders this at 1280x720 @ 15fps in a browser with 250 millicores and 750MB by default —
# nowhere near enough for this canvas. Use the `web_4_core` bot variant, which separate-participant
# audio requires anyway. Design for 720p: anything sized for a 1440px laptop screen is unreadable
# once the stream is re-encoded, and slow animation survives 15fps where fast animation judders.
RECALL_CANVAS_URL=

# ── Meeting canvas · the audio receiver (server/recall-receiver.mjs) ──────────
# Recall connects TO us and pushes per-participant audio, so this is the one part of the stack that
# needs an inbound port. Run it beside Minami on the Hetzner box and expose it with a Cloudflare
# named tunnel — stable wss:// hostname, TLS handled, firewall still closed to everything but SSH.
RECALL_RECEIVER_PORT=8787

# Shared secret appended to the realtime_endpoints URL as ?token=… Anyone who discovers the tunnel
# hostname can otherwise push audio straight into your meeting pipeline. The receiver logs a warning
# and accepts everything when this is empty, which is fine for a probe and not for a real meeting.
RECALL_RECEIVER_TOKEN=

# Where the receiver forwards each utterance. Leave EMPTY for a dry run: the receiver logs chunks and
# speakers without spending a cent on models, which is how you prove the audio leg before wiring the
# expensive half to it.
CANVAS_INGEST_URL=

# The receiver's PUBLIC wss:// address — what Recall connects back to. This is the tunnel hostname,
# not localhost; Recall dials in from its own infrastructure. Used by bin/minami-meet.mjs.
RECALL_RECEIVER_URL=

# How the bot presents the canvas: `screenshare` (default) or `camera`.
#
# Both render at 1280x720 @ 15fps — Recall caps EVERY variant there, including web_gpu, so 720p is
# their limit and not Google's (a human sharing their screen in Meet gets 1080p). What differs is how
# the platform ENCODES the track: a camera feed is motion-optimised for faces and smooths exactly the
# high-frequency detail that text is made of, while a screenshare is treated as content — sharp-edge
# preserving, given the big tile and the bitrate priority, and it sheds framerate before it sheds
# detail. Same pixels in, very different pixels out.
#
# Recall's own docs only ever show `camera`; `screenshare` was confirmed by probing the API.
RECALL_OUTPUT_MODE=

# ── Meeting canvas · budget and archive ──────────────────────────────────────
# Monthly ceiling in USD for the meeting bot. Checked BEFORE a bot is dispatched — refusing to
# dispatch is the only refusal that costs nothing, since a bot in a room bills whether or not anyone
# is watching. Minami warns at 80% and hard-stops at 100%. Set to 0 to disable the gate entirely.
# Default: 50 (~89 meeting-hours at the measured ~$0.56/hr).
CANVAS_BUDGET_USD=

# Where the running total lives. Keyed by month, so a new month starts at zero. Default: ~/.minami/canvas-budget.json
CANVAS_BUDGET_FILE=

# Where finished meetings are written: one folder per meeting holding notes.md, canvas.json and
# transcript.md. Markdown so it imports into Notion/Obsidian without a converter; JSON alongside it so
# the board is still a graph and can be re-rendered without paying the models again.
# Default: ~/.minami/meetings
CANVAS_ARCHIVE_DIR=

# ── the ear ─────────────────────────────────────────────────────────────────────────────────────
# Blaze (api.blaze.vn) is the DEFAULT speech-to-text: Vietnamese-native, and the only engine tested
# that transcribed a whole Vietnamese sentence correctly. chirp-3 invented a product name;
# whisper-large-v3 corrupted the Vietnamese itself. See lib/canvas-llm.ts for the measurement.
# NOTE: Blaze bills separately from OpenRouter and reports no usage, so it does NOT count toward
# CANVAS_BUDGET_USD. The monthly ceiling bounds the judge, not the ear.
BLAZE_API_KEY=
