# Real data wires in here later — never commit the filled-in version.
# The vault/qone/token data stays OUT of git; the public repo ships mock data only.
QONE_API_URL=
QONE_API_TOKEN=
VAULT_SYNC_URL=

# Live usage panel (both machines) — the metrics API served from the Hetzner box via Tailscale Funnel.
# NEXT_PUBLIC_* is exposed to the browser; the read key is obscurity only — gate the deploy for real privacy.
NEXT_PUBLIC_METRICS_URL=
NEXT_PUBLIC_METRICS_KEY=

# Optional gate for the live deploy (recommended even if the repo is public):
DASHBOARD_ACCESS_TOKEN=
