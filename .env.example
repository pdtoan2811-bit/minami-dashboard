# Minami Bento — environment.
#
# Copy to .env.local and fill in what you want. EVERYTHING here is OPTIONAL: the Bento home page (/)
# needs none of it — it reads ~/.claude/projects directly, so a fresh clone fills with your own
# Claude Code sessions on `npm run dev` with this file untouched.
#
# Never commit the filled-in .env.local (it's git-ignored).
#
# Every value below is shown as `NAME=` with its built-in default named in the comment above it.
# Blank means "use the default" — it does not mean "empty string". Defaults that mention a path are
# resolved against your own $HOME, so nothing here is specific to the machine that wrote it.

# ══ What you are most likely to want ═════════════════════════════════════════════════════════════

# ── Metrics API (powers the /dashboard cards) ────────────────────────────────
# Base URL of the self-hosted metrics collector (see server/README.md). Leave blank to run without
# cross-machine metrics — the metrics cards just show "no source".
# NEXT_PUBLIC_* is exposed to the browser; the read key is obscurity only, so gate the deploy
# (password / auth) if you need real privacy.
NEXT_PUBLIC_METRICS_URL=
NEXT_PUBLIC_METRICS_KEY=

# ── Pluggable side panels (/dashboard: Task log / People / Trace-back / Analytics)
# Absolute path to a JSON file that backs those cards. See panels.example.json for the shape.
# Leave blank and the cards are simply empty (no personal data ships in this repo).
# Default: unset — cards render empty.
MINAMI_PANELS_FILE=

# ── Browser tool (live-drive sessions) ────────────────────────────────────────
# Every live-driven chat is given a browser tool (Playwright MCP, headless, isolated per session) so
# Claude can navigate/click/screenshot your own apps for visual QA — see README.md. It's deferred
# behind tool search, so a chat that never uses it costs ~nothing. Set to 1 to turn it off entirely.
# Default: enabled.
MINAMI_DISABLE_BROWSER_TOOL=

# ── Preferred Claude account ──────────────────────────────────────────────────
# The account the Accounts panel expects every session to be billing. If the live credential in
# ~/.claude.json doesn't match this, the panel raises a wrong-account alert.
#
# Default: EMPTY, which switches the check OFF — with no preferred account there is no such thing as
# being off it. Set it here, or pick one in Settings (which writes ~/.minami/account.json and wins
# over this var). Only useful if you run several Claude accounts; if you have one, ignore this.
# Requires the `token-slayer` CLI to enumerate a pool.
MINAMI_PREFERRED_ACCOUNT=

# ══ Models ═══════════════════════════════════════════════════════════════════════════════════════
# All model ids live in lib/model-pins.ts. Never hardcode one elsewhere — the dashboard alerts when a
# spawner drifts off the pin, and a second copy of the id makes the alert lie.

# The model every judgement-layer spawner on this box should run. Default: claude-opus-5
MINAMI_PINNED_MODEL=

# The dashboard's own chat sessions. Default: whatever MINAMI_PINNED_MODEL resolves to.
MINAMI_DASHBOARD_MODEL=

# The cheap worker behind tile labels and goal/task inference. Deliberately NOT the pin — this is
# mechanical summarisation on a hot path. Default: claude-haiku-4-5
MINAMI_CHEAP_MODEL=

# Reasoning effort for dashboard sessions. Default: unset (the CLI's own default).
MINAMI_DASHBOARD_EFFORT=

# Auto-compact threshold, as a percentage of the context window. Default: the CLI's own default.
MINAMI_DASHBOARD_AUTOCOMPACT_PCT=

# Permission mode for every dashboard-hosted session. Default: bypassPermissions — every tool call is
# auto-approved with no prompt, enforced by the server's own canUseTool. Read the "Security posture"
# note in CLAUDE.md before changing this; the dashboard is built for loopback/local use.
MINAMI_DASHBOARD_PERMISSION_MODE=

# Where the Minami Slack bot repo lives, read only to report which model IT is pinned to. Absent on
# most machines, in which case the pin check reports "not found on this host" and moves on.
# Default: ~/Minami
MINAMI_BOT_DIR=

# ══ Paths and state ══════════════════════════════════════════════════════════════════════════════
# The dashboard keeps its own state under ~/.minami. Override individually only if you need to.

# Which URL the CLI tools (bin/agent.mjs, bin/task.mjs) and the agent runner call back on.
# Default: http://127.0.0.1:3000
MINAMI_DASHBOARD_URL=

# Agent registry: one JSON file per agent. Default: ~/.minami/agents
MINAMI_AGENTS_DIR=

# Assigned-task queue for agents. Default: ~/.minami/agent-tasks.json
MINAMI_AGENT_TASKS=

# Which account the wrong-account alert measures against. Default: ~/.minami/account.json
MINAMI_ACCOUNT_CONFIG=

# Autopilot's settings (merge / deploy / resolve toggles). Default: ~/.minami/autopilot.json
MINAMI_AUTOPILOT_CONFIG=

# Set to 1 to stop autopilot from running at all. Default: enabled (but it does nothing until you
# turn on merge/deploy in its config).
MINAMI_AUTOPILOT_DISABLE=

# Out-of-pane alert log, written by bin/minami-event.mjs so alerts survive the deploy that made them.
# Default: ~/.minami/events.jsonl
MINAMI_EVENTS=

# Where pasted images from the composer are written. Default: ~/.minami/pastes
MINAMI_PASTES=

# ══ Timeouts (milliseconds) ══════════════════════════════════════════════════════════════════════
# Raise these on a slow box; the defaults are tuned for a laptop that sleeps.

# How long a session may sit with NO connected client before its CLI subprocess is reaped. The floor
# is 60s. Backgrounding a mobile tab tears down the SSE stream, so "no listeners" is routine and
# temporary — that's why this is 30 minutes and not 10. Default: 1800000 (30 min)
MINAMI_IDLE_REAP_MS=

# How long a turn may stay parked on a permission / question prompt before it gives up.
# Default: see lib/agent/manager.ts
MINAMI_HOLD_TIMEOUT_MS=

# Ceiling on a single assigned agent task. Default: see lib/agents/runner.ts
MINAMI_AGENT_TASK_TIMEOUT_MS=

# How long an agent task may sit awaiting a human before the runner stops waiting.
# Default: see lib/agents/runner.ts
MINAMI_AGENT_AWAIT_LIMIT_MS=

# ══ Metrics collector (server/metrics-server.js) ═════════════════════════════════════════════════
# Only relevant if you run the collector — it's a separate process from the Next app.
# See server/README.md. It binds loopback by default; keep it that way unless you front it with TLS
# and auth, since it accepts writes.

# Port the collector listens on. Default: 8787
PORT=

# Interface it binds. Default: 127.0.0.1 (loopback only — do NOT expose this without auth)
BIND=

# Where it stores events.jsonl. Default: ~/.minami-metrics
METRICS_DIR=

# Shared secret required to WRITE metrics. Default: empty (no auth — fine on loopback only).
INGEST_TOKEN=

# Shared secret required to READ metrics. Must match NEXT_PUBLIC_METRICS_KEY above.
# Default: empty (no auth).
READ_KEY=
